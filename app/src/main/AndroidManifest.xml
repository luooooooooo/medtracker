<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MedTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- 桌面图标多入口：通过 activity-alias 动态切换启动器图标（同一 MainActivity） -->
        <activity-alias
            android:name=".icon_chiikawa"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_chiikawa"
            android:roundIcon="@mipmap/ic_launcher_chiikawa"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon_hachiware"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_hachiware"
            android:roundIcon="@mipmap/ic_launcher_hachiware"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon_usagi"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_usagi"
            android:roundIcon="@mipmap/ic_launcher_usagi"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon_pill"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pill"
            android:roundIcon="@mipmap/ic_launcher_pill"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon_mint"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mint"
            android:roundIcon="@mipmap/ic_launcher_mint"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon_heart"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_heart"
            android:roundIcon="@mipmap/ic_launcher_heart"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 全透明图标：直接引用全透明 PNG（传统图标，不走自适应图标），
             切换后应用本体图标在桌面真正不可见，可隐藏自定义图标的右下角角标 -->
        <activity-alias
            android:name=".icon_invisible"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_invisible_fg"
            android:roundIcon="@drawable/ic_launcher_invisible_fg"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".StatsActivity"
            android:exported="false" />

        <activity
            android:name=".CropActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <receiver
            android:name=".MidnightReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 桌面小部件：主屏幕直接打卡 -->
        <receiver
            android:name=".MedWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/med_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
