<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小部件根布局：头部 + 固定 2行x3列 时段卡片网格（6 槽位，按次数显示/隐藏） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="#333838"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#707B78"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- 第 1 行：槽位 0-2（1~3 次时单独成行） -->
    <LinearLayout
        android:id="@+id/wRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/wSlot0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/wIcon0"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@string/widget_slot_icon_desc"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/wName0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#333838"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wSlot1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/wIcon1"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@string/widget_slot_icon_desc"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/wName1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#333838"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wSlot2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/wIcon2"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@string/widget_slot_icon_desc"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/wName2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#333838"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第 2 行：槽位 3-5（4~6 次时启用） -->
    <LinearLayout
        android:id="@+id/wRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/wSlot3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/wIcon3"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@string/widget_slot_icon_desc"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/wName3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#333838"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wSlot4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/wIcon4"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@string/widget_slot_icon_desc"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/wName4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#333838"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wSlot5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/wIcon5"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@string/widget_slot_icon_desc"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/wName5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#333838"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
